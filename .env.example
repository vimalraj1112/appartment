# ============================================================
# SuperLink Community — environment (copy to apps/api/.env)
# ============================================================

# --- API ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql://superlink:superlink_dev_pw@localhost:5433/superlink
TEST_DATABASE_URL=postgresql://superlink:superlink_dev_pw@localhost:5433/superlink_test

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
REFRESH_COOKIE_NAME=sl_refresh
REFRESH_COOKIE_DAYS=30

# Rate limiting
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=10

# --- WEB (apps/web/.env) ---
VITE_API_URL=http://localhost:4000/api/v1


# --- WEB (apps/web/.env) ---
VITE_WHATSAPP_NUMBER=919000000000

# --- providers (MOCK keeps everything offline; env-gate real adapters in prod) ---
PAYMENT_PROVIDER=MOCK
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
LLM_PROVIDER=MOCK
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- production (docker-compose.prod.yml) ---
# required: JWT_ACCESS_SECRET (min 32 chars), POSTGRES_PASSWORD
# optional: WEB_PORT (default 8080), WEB_URL, CORS_ORIGIN, API_BASE_URL
